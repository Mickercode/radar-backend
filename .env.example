# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins. Use * in dev. The Expo app sends
# requests without a browser Origin header, so CORS is mostly a no-op for it —
# this matters if you ever hit the API from a web build.
CORS_ORIGIN=*

# ── Database ───────────────────────────────────────────────────────────────────
# Fresh Postgres (Render/Neon). Must support the pgvector extension for the
# knowledge-graph embeddings. Neon and Render Postgres both do.
DATABASE_URL=postgresql://user:password@host:5432/radar?schema=public

# ── Podcast Index (podcast search) ────────────────────────────────────────────
# Free API key from https://podcastindex.org/. Without these, the podcast search
# and episode browsing features fall back to mock/demo mode.
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# ── ListenNotes (podcast gap-fill) ────────────────────────────────────────────
# 300 requests/month on the free tier. Used by the gap-fill job as the primary
# podcast source (higher quality + direct MP3 links). Falls back to Podcast Index
# RSS when the monthly budget drops below 5 remaining requests.
LISTENNOTES_API_KEY=

# ── Auth ───────────────────────────────────────────────────────────────────────
# Secret used to sign/verify our own JWTs. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# This REPLACES the old Supabase JWT secret — it no longer needs to match anything.
APP_JWT_SECRET=

# ── AI pipeline (used by /capture, quiz generation, auto-link) ───────────────────
# The pipeline runs on Gemini (gemini-2.0-flash + text-embedding-004). Set this
# to use /capture, quiz generation, and insight auto-linking; without it those
# routes return a clean 503 (the rest of the API works fine).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Groq — free tier, fast Llama 3.3 70B. https://console.groq.com
GROQ_API_KEY=
# Cerebras — free tier. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter — deepseek/deepseek-chat (top up credits to re-enable)
OPENROUTER_API_KEY=

# ── S3 podcast cache ──────────────────────────────────────────────────────────
# Private S3 bucket for persisting podcast episodes between ingest runs.
# The ingest job writes to this; /podcasts/live reads from it first.
S3_PODCAST_BUCKET=radar-podcasts-cache
